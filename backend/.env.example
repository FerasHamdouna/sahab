# Copy to .env and fill in.

PORT=8080

# Local PostgreSQL. The database is created automatically if it doesn't exist.
# Leave empty to run with the in-memory cache only.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/sahab

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Requests per minute per IP.
RATE_LIMIT_PER_MIN=120
